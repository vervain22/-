# FMC J2 摄像头时钟约束
define_attribute {n:cmos_fmc_pclk} {PAP_CLOCK_DEDICATED_ROUTE} {FALSE}
create_clock -name {cmos_fmc_pclk} [get_ports {cmos_fmc_pclk}] -period {11.900} -waveform {0.000 5.950}
# 摄像头像素时钟经 IOCLKDIV 二分频，父子时钟保持相关。
# 摄像头时钟域与 DDR、PCIe 时钟域异步，DDR PHY 同步路径保持原约束。
create_generated_clock -name {fmc_pixel_clk} -source [get_ports {cmos_fmc_pclk}] [get_pins {u_ov5640_fmc.u_pack_rgb565.u_GTP_IOCLKDIV/CLKDIVOUT}] -master_clock [get_clocks {cmos_fmc_pclk}] -divide_by {2}
set_clock_groups -name group_fmc_camera -asynchronous -group [get_clocks {cmos_fmc_pclk fmc_pixel_clk}]

